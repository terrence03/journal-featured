# 這些設定也可以在網頁介面「API 與寄信」頁填寫（存於 data/secrets.env，優先於本檔）

# OpenAlex
OPENALEX_API_KEY='your-openalex-api-key'

# Claude API（選填；未設定則略過精選）
ANTHROPIC_API_KEY=
# key 未綁定 workspace 時必填（Console → Settings → Workspaces 的 ID）
ANTHROPIC_WORKSPACE_ID=

# Gmail SMTP（應用程式密碼：https://myaccount.google.com/apppasswords）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD='xxxx xxxx xxxx xxxx'

# 排程（選填）
# CRON_SCHEDULE="0 8 * * 1"
# TZ=Asia/Taipei

# 網頁介面綁定位址（選填；預設 127.0.0.1 僅本機，設 0.0.0.0 允許區網連線，介面無登入機制）
# WEB_BIND=127.0.0.1
